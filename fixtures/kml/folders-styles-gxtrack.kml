  </Style>
  <StyleMap id="map-line">
    <Pair><key>normal</key><styleUrl>#blue-line</styleUrl></Pair>
    <Pair><key>highlight</key><styleUrl>#red-line</styleUrl></Pair>
  </StyleMap>
  <Folder>
