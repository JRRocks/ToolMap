{
  "rules": {
    ".read": false,
    ".write": false,
    "reports": {
      ".read": "auth != null && auth.token.email === 'reports@toolmap.invalid' && auth.token.firebase.sign_in_provider === 'password'",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && auth.token.email === 'reports@toolmap.invalid' && auth.token.firebase.sign_in_provider === 'password'))",
        ".validate": "$id.matches(/^[0-9a-f]{16}-[0-9a-z]{10}$/) && newData.hasChildren(['v', 'j', 't'])",
        "v": { ".validate": "newData.isNumber() && newData.val() === 1" },
        "j": { ".validate": "newData.isString() && newData.val().length <= 16000" },
        "t": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$x": { ".validate": false }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[0-9a-f]{32}$/)",
        ".write": "auth != null && $room.matches(/^[0-9a-f]{32}$/)",
        "$other": { ".validate": "$other === 'b'" },
        "b": {
          "w": {
            "$point": {
              ".validate": "$point.matches(/^p[0-9a-f]{1,16}$/) && newData.hasChildren(['f', 't'])",
              "f": { ".validate": "newData.isString() && newData.val().length <= 17000" },
              "t": { ".validate": "newData.isNumber()" },
              "$x": { ".validate": false }
            }
          },
          "$member": {
            ".validate": "$member.matches(/^m[0-9a-f]{1,16}$/)",
            "h": {
              ".validate": "newData.hasChildren(['t', 'n', 'k'])",
              "t": { ".validate": "newData.isNumber()" },
              "n": { ".validate": "newData.isString() && newData.val().length <= 64" },
              "k": { ".validate": "newData.isNumber()" },
              "$x": { ".validate": false }
            },
            "p": {
              ".validate": "newData.hasChildren(['f', 't'])",
              "f": { ".validate": "newData.isString() && newData.val().length <= 400" },
              "t": { ".validate": "newData.isNumber()" },
              "$x": { ".validate": false }
            },
            "c": {
              "$id": {
                ".validate": "newData.hasChildren(['f', 't'])",
                "f": { ".validate": "newData.isString() && newData.val().length <= 6000" },
                "t": { ".validate": "newData.isNumber()" },
                "$x": { ".validate": false }
              }
            },
            "$x": { ".validate": false }
          }
        }
      }
    }
  }
}
