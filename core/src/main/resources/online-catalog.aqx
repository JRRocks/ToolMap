  <source id="cat-ign-etatmajor" type="historical">
    <name>IGN État-major 1:40 000 (1820-1866)</name>
    <copyright>IGN</copyright>
    <data-source>https://data.geopf.fr</data-source>
    <region>WRLD</region>
    <preview-location>2.35,48.85,12</preview-location>
    <zoom-levels z="6-15">
      <referer><![CDATA[https://data.geopf.fr/]]></referer>
      <max-threads>2</max-threads>
      <server><![CDATA[https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&STYLE=normal&TILEMATRIXSET=PM&TILEMATRIX={$z}&TILEROW={$y}&TILECOL={$x}&LAYER=GEOGRAPHICALGRIDSYSTEMS.ETATMAJOR40&FORMAT=image/jpeg]]></server>
    </zoom-levels>
  </source>

  <source id="cat-ign-ortho1950" type="historical">
