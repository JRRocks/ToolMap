  <source id="cat-os-outdoor" type="topo">
    <name>Ordnance Survey Outdoor (clé requise)</name>
    <copyright>© Crown copyright and database rights Ordnance Survey</copyright>
    <data-source>https://osdatahub.os.uk</data-source>
    <region>WRLD</region>
    <param name="os-key"></param>
    <preview-location>-3.00,54.45,11</preview-location>
    <zoom-levels z="7-16">
      <max-threads>2</max-threads>
      <server><![CDATA[https://api.os.uk/maps/raster/v1/zxy/Outdoor_3857/{$z}/{$x}/{$y}.png?key={$param:os-key}]]></server>
    </zoom-levels>
  </source>

