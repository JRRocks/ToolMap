<?xml version="1.0" encoding="utf-8"?>
<aqx version="11">
  <name>ToolMap - catalogue de cartes en ligne</name>
  <description>Cartes que l'on peut ajouter en un geste (Cartes, Ajouter une carte, Catalogue en ligne). Seules figurent des sources dont les conditions d'usage permettent l'acces direct aux tuiles ; les identifiants commencent par cat-. Un parametre vide est une cle d'API que l'utilisateur renseigne a l'ajout.</description>

  <source id="cat-osm-france" type="topo">
    <name>OpenStreetMap France</name>
    <copyright>(c) OpenStreetMap contributors | Style : OpenStreetMap France</copyright>
    <data-source>https://www.openstreetmap.fr</data-source>
    <region>WRLD</region>
    <preview-location>5.90,44.80,14</preview-location>
    <zoom-levels z="0-19">
      <user-agent>ToolMap/0.4 (+https://github.com/JRRocks/ToolMap)</user-agent>
      <max-threads>2</max-threads>
      <server><![CDATA[https://a.tile.openstreetmap.fr/osmfr/{$z}/{$x}/{$y}.png]]></server>
      <server><![CDATA[https://b.tile.openstreetmap.fr/osmfr/{$z}/{$x}/{$y}.png]]></server>
    </zoom-levels>
  </source>

