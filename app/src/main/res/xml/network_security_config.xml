<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security (ADR-017, ADR-066).
    - Clear text stays allowed: many map servers in AQX files only speak http:// (the wizard warns about them).
    - Certificates: the system authorities, plus those the user installed in Android (Settings > Security >
      Encryption and credentials). A WMS server signed by a company or administration authority then works,
      without the "accept any certificate" switch that Google Play refuses.
    - The update channel (GitHub: release list and APK download, P31) trusts the system authorities only: an
      authority installed by the user (or by a network that inspects TLS) must not be able to serve another APK or
      hide an update (P36 review).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
