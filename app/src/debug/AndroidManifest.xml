<?xml version="1.0" encoding="utf-8"?>
<!--
    The debug build type is the APK handed to users (CI, ADR-047). Two activities that tooling libraries add to debug
    builds are exported there, so any app could start them (P36 review):
    - Compose's PreviewActivity runs any composable named in its extras: removed (previews render in Robolectric).
    - The empty ComponentActivity of compose-ui-test-manifest hosts the Robolectric Compose tests: kept, not exported.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- An invitation to an operation, toolmap://operation?d=... (P39.8, ADR-130): the « Opération » mode exists in
             this build type only while it is designed (ADR-124). -->
        <activity
            android:name="fr.toolmap.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="toolmap" android:host="operation" />
            </intent-filter>
        </activity>
        <!-- The sharing of an operation, the app open or not (P39.14, L4): its line in ToolMap's notification. -->
        <service
            android:name="fr.toolmap.operation.OperationService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:node="remove" />
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
