# Firebase emulator logs, written at the root by scripts/firebase-emulator-test.sh
/*-debug.log

# Fixed debug signing key (not a secret: debug builds only)
!app/debug.keystore

# Firebase emulator log
firebase/*-debug.log

# JVM crash reports: they hold the user name, paths and environment of the machine
hs_err_pid*.log
replay_pid*.log
*.hprof

# cargo's build folder, should it be run without engine/src/main/rust/.cargo/config.toml (it builds in engine/build)
engine/src/main/rust/target/
